# Environment
ENV=development

# OpenRouter API Configuration
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
DEFAULT_CHAT_MODEL=deepseek/deepseek-chat
DEFAULT_IMAGE_MODEL=openai/dall-e-3

# Database
DATABASE_URL=sqlite+aiosqlite:///./productor.db
OUTPUT_DIR=./output

# JWT Configuration (REQUIRED in production - min 32 characters recommended)
# Generate with: openssl rand -hex 32
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRE_HOURS=72

# CORS Configuration (REQUIRED in production)
# Comma-separated list of allowed origins
# Example: CORS_ALLOW_ORIGINS=https://app.example.com,https://admin.example.com
CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:3000

# SMTP Configuration (optional - leave empty for console output in dev)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@productor.local

# Storage Configuration
# Options: local, s3
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./uploads
LOCAL_STORAGE_URL_BASE=/uploads

# S3 Configuration (required when STORAGE_BACKEND=s3)
S3_ENDPOINT_URL=                    # For MinIO, Aliyun OSS, etc.
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
S3_BUCKET_PREFIX=productor-

# Celery Configuration (for background tasks)
# Redis is used as both broker and result backend
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
